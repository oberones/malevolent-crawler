{
  "name": "malevolent-crawler",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.22.1",
    "npm": "12.2.1"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "http-server . -a 127.0.0.1 -p 4173 -c-1 --silent",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:integration": "playwright test tests/integration",
    "test:browser": "playwright test tests/browser",
    "test:container": "bash scripts/smoke-container.sh",
    "test:performance": "playwright test tests/performance --project=chromium --workers=1",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "validate:evidence": "node scripts/validate-evidence.mjs",
    "serve:performance": "http-server . -a 127.0.0.1 -p 4174 -c3600 --silent"
  },
  "dependencies": {
    "howler": "2.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "http-server": "14.1.1",
    "prettier": "3.9.10"
  }
}
